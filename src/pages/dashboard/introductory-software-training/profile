import { FormEvent, useEffect, useState } from "react";
import { useRouter } from "next/router";
import Link from "next/link";
import { academySupabase } from "../../../lib/academySupabase";

type Mode = "create" | "signin";

type AcademyProfile = {
  first_name: string;
  last_name: string | null;
};

export default function AcademyProfilePage() {
  const router = useRouter();

  const [mode, setMode] = useState<Mode>("create");

  const [firstName, setFirstName] = useState("");
  const [lastName, setLastName] = useState("");
  const [email, setEmail] = useState("");
  const [password, setPassword] = useState("");
  const [confirmPassword, setConfirmPassword] = useState("");

  const [loading, setLoading] = useState(false);
  const [checkingSession, setCheckingSession] = useState(true);

  const [error, setError] = useState("");
  const [message, setMessage] = useState("");

  const [signedIn, setSignedIn] = useState(false);
  const [profile, setProfile] = useState<AcademyProfile | null>(null);

  useEffect(() => {
    checkAcademySession();
  }, []);

  async function checkAcademySession() {
    setCheckingSession(true);

    const {
      data: { session },
    } = await academySupabase.auth.getSession();

    if (!session?.user) {
      setSignedIn(false);
      setCheckingSession(false);
      return;
    }

    const { data } = await academySupabase
      .from("academy_profiles")
      .select("first_name, last_name")
      .eq("id", session.user.id)
      .single();

    if (data) {
      setProfile(data);
    }

    setSignedIn(true);
    setCheckingSession(false);
  }

  async function createTrainingProfile(event: FormEvent) {
    event.preventDefault();

    setError("");
    setMessage("");

    if (!firstName.trim()) {
      setError("Please enter your first name.");
      return;
    }

    if (!email.trim()) {
      setError("Please enter your email.");
      return;
    }

    if (password.length < 8) {
      setError("Please choose a password with at least 8 characters.");
      return;
    }

    if (password !== confirmPassword) {
      setError("The passwords do not match.");
      return;
    }

    setLoading(true);

    try {
      const { data, error: signupError } =
        await academySupabase.auth.signUp({
          email: email.trim().toLowerCase(),
          password,
        });

      if (signupError) {
        throw signupError;
      }

      if (!data.user) {
        throw new Error("The training account could not be created.");
      }

      /*
        We intentionally expect an immediate session because this Academy
        signup is designed not to require email confirmation.
      */
      if (!data.session) {
        throw new Error(
          "Your account was created, but Supabase is waiting for email confirmation. Disable Confirm Email in Supabase before using Academy signup."
        );
      }

      const { error: profileError } = await academySupabase
        .from("academy_profiles")
        .insert({
          id: data.user.id,
          first_name: firstName.trim(),
          last_name: lastName.trim() || null,
          last_active_at: new Date().toISOString(),
        });

      if (profileError) {
        throw profileError;
      }

      const { error: progressError } = await academySupabase
        .from("academy_course_progress")
        .insert({
          user_id: data.user.id,
          current_lesson: 1,
          current_step: 1,
          last_page:
            "/dashboard/introductory-software-training",
          updated_at: new Date().toISOString(),
        });

      if (progressError) {
        throw progressError;
      }

      setMessage("Training profile created successfully.");

      await router.push(
        "/dashboard/introductory-software-training"
      );
    } catch (err: any) {
      setError(
        err?.message ||
          "Something went wrong while creating your training profile."
      );
    } finally {
      setLoading(false);
    }
  }

  async function signIn(event: FormEvent) {
    event.preventDefault();

    setError("");
    setMessage("");

    if (!email.trim() || !password) {
      setError("Enter your email and password.");
      return;
    }

    setLoading(true);

    try {
      const { data, error: signInError } =
        await academySupabase.auth.signInWithPassword({
          email: email.trim().toLowerCase(),
          password,
        });

      if (signInError) {
        throw signInError;
      }

      if (!data.user) {
        throw new Error("Unable to sign into the training profile.");
      }

      await academySupabase
        .from("academy_profiles")
        .update({
          last_active_at: new Date().toISOString(),
        })
        .eq("id", data.user.id);

      await router.push(
        "/dashboard/introductory-software-training"
      );
    } catch (err: any) {
      setError(
        err?.message ||
          "Unable to sign into your training profile."
      );
    } finally {
      setLoading(false);
    }
  }

  async function signOut() {
    setLoading(true);

    await academySupabase.auth.signOut();

    setSignedIn(false);
    setProfile(null);
    setEmail("");
    setPassword("");
    setConfirmPassword("");

    setLoading(false);
  }

  if (checkingSession) {
    return (
      <main className="page">
        <div className="loadingCard">
          <p>Loading training profile...</p>
        </div>

        <PageStyles />
      </main>
    );
  }

  if (signedIn) {
    return (
      <main className="page">
        <section className="profileShell">
          <div className="brand">
            <p className="eyebrow">Rhino Wrangler Academy</p>

            <h1>
              Welcome back
              {profile?.first_name
                ? `, ${profile.first_name}`
                : ""}
            </h1>

            <p className="lead">
              Your training profile is active. Your course progress
              will be saved to this profile as you work through the
              Academy.
            </p>
          </div>

          <div className="signedInCard">
            <div className="statusIcon">✓</div>

            <div>
              <p className="smallLabel">
                Training Profile Active
              </p>

              <h2>
                {profile
                  ? `${profile.first_name}${
                      profile.last_name
                        ? ` ${profile.last_name}`
                        : ""
                    }`
                  : "Academy Trainee"}
              </h2>

              <p>
                Continue your current course or return to the
                curriculum to choose a lesson.
              </p>
            </div>
          </div>

          <div className="actionRow">
            <Link
              href="/dashboard/introductory-software-training"
              className="primaryButton"
            >
              Continue Training →
            </Link>

            <button
              type="button"
              className="secondaryButton"
              onClick={signOut}
              disabled={loading}
            >
              Sign Out of Training Profile
            </button>
          </div>

          <div className="importantNote">
            <strong>Training profile only</strong>

            <p>
              Signing out here only signs out your personal Academy
              training profile. It does not sign the company out of
              The Rhino Wrangler.
            </p>
          </div>
        </section>

        <PageStyles />
      </main>
    );
  }

  return (
    <main className="page">
      <section className="profileShell">
        <div className="brand">
          <p className="eyebrow">Rhino Wrangler Academy</p>

          <h1>Your Personal Training Profile</h1>

          <p className="lead">
            Create a personal Academy profile to save your position,
            track completed lessons, and continue training from any
            computer.
          </p>
        </div>

        <div className="infoBox">
          <strong>This does not affect your company's access.</strong>

          <p>
            Your training profile is separate from the login used to
            access The Rhino Wrangler. It is only used to remember your
            individual Academy progress.
          </p>
        </div>

        <div className="tabRow">
          <button
            type="button"
            className={
              mode === "create"
                ? "tabButton active"
                : "tabButton"
            }
            onClick={() => {
              setMode("create");
              setError("");
              setMessage("");
            }}
          >
            Create Training Profile
          </button>

          <button
            type="button"
            className={
              mode === "signin"
                ? "tabButton active"
                : "tabButton"
            }
            onClick={() => {
              setMode("signin");
              setError("");
              setMessage("");
            }}
          >
            Sign In
          </button>
        </div>

        {mode === "create" ? (
          <form
            className="formCard"
            onSubmit={createTrainingProfile}
          >
            <div className="formHeading">
              <p className="eyebrow">New Trainee</p>

              <h2>Create Training Profile</h2>

              <p>
                Your progress will be attached to this account.
              </p>
            </div>

            <div className="nameGrid">
              <label>
                <span>First Name</span>

                <input
                  type="text"
                  value={firstName}
                  onChange={(e) =>
                    setFirstName(e.target.value)
                  }
                  autoComplete="given-name"
                  placeholder="First name"
                  required
                />
              </label>

              <label>
                <span>Last Name</span>

                <input
                  type="text"
                  value={lastName}
                  onChange={(e) =>
                    setLastName(e.target.value)
                  }
                  autoComplete="family-name"
                  placeholder="Last name"
                />
              </label>
            </div>

            <label>
              <span>Email</span>

              <input
                type="email"
                value={email}
                onChange={(e) => setEmail(e.target.value)}
                autoComplete="email"
                placeholder="you@company.com"
                required
              />
            </label>

            <label>
              <span>Password</span>

              <input
                type="password"
                value={password}
                onChange={(e) =>
                  setPassword(e.target.value)
                }
                autoComplete="new-password"
                placeholder="Create a password"
                required
              />
            </label>

            <label>
              <span>Confirm Password</span>

              <input
                type="password"
                value={confirmPassword}
                onChange={(e) =>
                  setConfirmPassword(e.target.value)
                }
                autoComplete="new-password"
                placeholder="Enter the password again"
                required
              />
            </label>

            {error && (
              <div className="errorBox">{error}</div>
            )}

            {message && (
              <div className="successBox">{message}</div>
            )}

            <button
              className="submitButton"
              type="submit"
              disabled={loading}
            >
              {loading
                ? "Creating Profile..."
                : "Create Training Profile →"}
            </button>

            <p className="switchText">
              Already have a training profile?{" "}
              <button
                type="button"
                onClick={() => {
                  setMode("signin");
                  setError("");
                }}
              >
                Sign in here
              </button>
            </p>
          </form>
        ) : (
          <form
            className="formCard"
            onSubmit={signIn}
          >
            <div className="formHeading">
              <p className="eyebrow">Returning Trainee</p>

              <h2>Continue Your Training</h2>

              <p>
                Sign in to restore your saved Academy progress.
              </p>
            </div>

            <label>
              <span>Email</span>

              <input
                type="email"
                value={email}
                onChange={(e) => setEmail(e.target.value)}
                autoComplete="email"
                placeholder="you@company.com"
                required
              />
            </label>

            <label>
              <span>Password</span>

              <input
                type="password"
                value={password}
                onChange={(e) =>
                  setPassword(e.target.value)
                }
                autoComplete="current-password"
                placeholder="Your training password"
                required
              />
            </label>

            {error && (
              <div className="errorBox">{error}</div>
            )}

            {message && (
              <div className="successBox">{message}</div>
            )}

            <button
              className="submitButton"
              type="submit"
              disabled={loading}
            >
              {loading
                ? "Signing In..."
                : "Continue Training →"}
            </button>

            <p className="switchText">
              Need a training profile?{" "}
              <button
                type="button"
                onClick={() => {
                  setMode("create");
                  setError("");
                }}
              >
                Create one here
              </button>
            </p>
          </form>
        )}

        <Link
          href="/dashboard/introductory-software-training"
          className="backLink"
        >
          ← Back to Academy
        </Link>
      </section>

      <PageStyles />
    </main>
  );
}

